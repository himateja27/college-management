{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run College Management API",
			"type": "shell",
			"command": "${workspaceFolder}/college-management/.venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"main:app",
				"--env-file",
				".env",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"options": {
				"cwd": "${workspaceFolder}/college-management"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}